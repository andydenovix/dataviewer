rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLabMember(labId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/labs/$(labId)) &&
        request.auth.uid in get(/databases/$(database)/documents/labs/$(labId)).data.get('members', []);
    }

    // Samples — owner or shared-lab member can read; only owner can write
    match /samples/{sampleId} {
      allow read: if request.auth != null && (
        resource.data.get('userId', '') == request.auth.uid ||
        (resource.data.get('sharedWithLabId', '') != '' && isLabMember(resource.data.sharedWithLabId))
      );
      allow create: if request.auth != null && request.resource.data.get('userId', '') == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.get('userId', '') == request.auth.uid;
    }

    // Labs — members can read; members can update (e.g. add samples/share);
    // only creator can delete. Create is open to any authed user (lab creation flow).
    match /labs/{labId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.get('members', []);
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.get('members', []);
      allow delete: if request.auth != null && resource.data.get('creatorId', '') == request.auth.uid;
    }

    // Projects — owner only
    match /projects/{projectId} {
      allow read, update, delete: if request.auth != null && resource.data.get('userId', '') == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Notifications — owner can read/update/delete; any authed user can create
    // (colleagues send notifications during the sharing flow)
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && resource.data.get('userId', '') == request.auth.uid;
      allow create: if request.auth != null;
    }

    // Comments — any authed user can read; only author can create
    // No update/delete: comments are intentionally immutable
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.get('userId', '') == request.auth.uid;
    }

    // User settings (personal QC profile, preferences) — strict owner-only
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Protocol Templates — owner only
    match /protocols/{protocolId} {
      allow read, update, delete: if request.auth != null && resource.data.get('userId', '') == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Reference Spectra — owner only
    match /referenceSpectra/{spectrumId} {
      allow read, update, delete: if request.auth != null && resource.data.get('userId', '') == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
